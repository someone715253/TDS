script/source = "extends StaticBody2D

var Bullet = preload(\"res://Towers/Bullets/BulletA/bullet.tscn\")
var bulletDamage = 5
var pathName
var currentTargets = []
var current
var reload = 0
var range = 600
var tier = 0
var spent = 10
var is_preview = false
var stats = [
	{\"bulletDamage\":5, \"range\": 600, \"reload\": 0.0, \"upgrade_cost\": 0},
	{\"bulletDamage\":5, \"range\": 300, \"reload\": 0.0, \"upgrade_cost\": 0},
	{\"bulletDamage\":5, \"range\": 300, \"reload\": 0.0, \"upgrade_cost\": 0},
	{\"bulletDamage\":5, \"range\": 300, \"reload\": 0.0, \"upgrade_cost\": 0},
	{\"bulletDamage\":5, \"range\": 300, \"reload\": 0.0, \"upgrade_cost\": 0},
]

@onready var timer = get_node(\"Upgrade/ProgressBar/Timer\")
var startShooting = false

func _ready() -> void:
	get_node(\"Upgrade/Upgrade\").hide()
	update_powers()
	
func _process(delta):
	if is_preview:
		return
	if not is_valid_target(current):
		currentTargets = get_node(\"Tower\").get_overlapping_bodies()
		pick_target()
	get_node(\"Upgrade/ProgressBar\").global_position = self.position + Vector2 (-64,-96)
	if is_instance_valid(current):
		self.look_at(current.global_position)
		if timer.is_stopped():
			Shoot()
			timer.start()
	else:
		timer.stop()
		for i in get_node(\"BulletContainer\").get_child_count():
			get_node(\"BulletContainer\").get_child(i).queue_free()
	update_powers()

func is_valid_target(target) -> bool:
	if not is_instance_valid(target):
		return false
	if target.get_child_count() == 0:
		return false
	return is_instance_valid(target.get_child(0))

func upgrade_tower():
	if tier >= stats.size() -1:
		return
	var next = stats[tier + 1]
	if Game.money >= next.upgrade_cost:
		Game.money -= next.upgrade_cost
		spent += next.upgrade_cost
		tier += 1 
		bulletDamage = next.bulletDamage
		range = next.range
		reload = next.reload
		timer.wait_time = 3 - reload
		update_powers()
		
func update_powers():
	if tier < stats.size() - 1:
		var next = stats[tier + 1]
		get_node(\"Upgrade/Upgrade/FireRate\").text = \"Fire Rate: %s → %s\" % [3- reload, 3 - next.reload]
		get_node(\"Upgrade/Upgrade/Range\").text = \"Range: %s → %s\" % [range, next.range]
		get_node(\"Upgrade/Upgrade/Damage\").text = \"Damage: %s → %s\" % [bulletDamage, next.bulletDamage]
		get_node(\"Upgrade/Upgrade/Upgradebutton/Label\").text = \"Tier %d → %d ($%d)\" % [tier, tier+1, next.upgrade_cost]
	else:
		get_node(\"Upgrade/Upgrade/FireRate\").text = \"Fire Rate: %s\" % (3 - reload)
		get_node(\"Upgrade/Upgrade/Range\").text = \"Range: %s\" % range
		get_node(\"Upgrade/Upgrade/Damage\").text = \"Damage: %s\" % bulletDamage
		get_node(\"Upgrade/Upgrade/Upgradebutton/Label\").text = \"MAX\"
		
	get_node(\"Tower/CollisionShape2D\").shape.radius = range

func sell():
	var refund = int(spent * 0.7)
	Game.money += refund
	queue_free()

func Shoot():
	var tempBullet = Bullet.instantiate()
	tempBullet.pathName = pathName
	tempBullet.bulletDamage = bulletDamage
	get_node(\"BulletContainer\").add_child(tempBullet)
	tempBullet.global_position = $Aim.global_position

func pick_target():
	var tempArray = []
	for i in currentTargets:
		if i.is_in_group(\"Enemies\"):
			tempArray.append(i)
	var currentTarget = null
	for i in tempArray:
		if currentTarget == null:
			currentTarget = i.get_node(\"../\")
		else:
			if i.get_parent().get_progress() > currentTarget.get_progress():
				currentTarget = i.get_node(\"../\")
	current = currentTarget
	if current:
		pathName = currentTarget.get_parent().name
	else:
		pathName = null



func _on_tower_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"Enemies\"):
		currentTargets = get_node(\"Tower\").get_overlapping_bodies()
		pick_target()


func _on_tower_body_exited(body: Node2D) -> void:
	currentTargets = get_node(\"Tower\").get_overlapping_bodies()
	if body.get_parent() == current:
		pick_target()
		


func _on_input_event(viewport: Node, event: InputEvent, shape_idx: int) -> void:
	print(\"clicked\")
	if event is InputEventMouseButton and event.button_mask == 1:
		var towerPath = get_tree().get_root().get_node(\"/root/Main/Towers\")
		for i in towerPath.get_child_count():
			if towerPath.get_child(i).name != self.name:
				var otherTower = towerPath.get_child(i)
				var upgradePanel = towerPath.get_child(i).get_node_or_null(\"Upgrade/Upgrade\")
				if upgradePanel:
					upgradePanel.hide()
				var RangeA = otherTower.get_node_or_null(\"Tower/CollisionShape2D\")
				if RangeA:
					RangeA.hide()
		get_node(\"Upgrade/Upgrade\").visible = !get_node(\"Upgrade/Upgrade\").visible
		get_node(\"Upgrade/Upgrade\").global_position = global_position + Vector2(-143, 40.5)
		
		if get_node(\"Upgrade/Upgrade\").visible:
			get_node(\"Tower/CollisionShape2D\").show()
		else:
			get_node(\"Tower/CollisionShape2D\").hide()
		

func _on_timer_timeout() -> void:
	Shoot()
	
func _on_range_mouse_entered() -> void:
	get_node(\"Tower/CollisionShape2D\").show()

func _on_range_mouse_exited() -> void:
	get_node(\"Tower/CollisionShape2D\").hide()

func _on_upgrade_button_pressed() -> void:
	upgrade_tower()
	
func _on_sell_pressed() -> void:
	sell()
	
"

